# --- MyGuide environment ---

# Secret used to sign login sessions. Required in production.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=

# SQLite database location. Local file by default.
# For a hosted deployment you can point this at a Turso/libSQL database instead:
#   DATABASE_URL=libsql://your-db.turso.io
#   DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./data/myguide.db
DATABASE_AUTH_TOKEN=

# Google Maps Platform (Places API (New) must be enabled on the key).
# Leave empty to run on realistic mock place data. The app switches to live
# data automatically once a key is present.
GOOGLE_MAPS_API_KEY=
# Same key, but exposed to the browser for rendering the map (Maps JavaScript API).
# Restrict this key by HTTP referrer in Google Cloud Console before shipping.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Anthropic API key for AI place parsing, natural-language search and note polishing.
# Leave empty to fall back to the built-in heuristics.
ANTHROPIC_API_KEY=
# Optional: override the model used for AI features.
ANTHROPIC_MODEL=claude-opus-5

# Seed demo users and guides into an empty database (default: true outside production).
SEED_DEMO=true

# Public origin used when building share links (falls back to the request origin).
NEXT_PUBLIC_APP_URL=

# "Continue with Google" (optional — the button only shows when both are set).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorised redirect URI: https://<your domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# "Continue with Apple" (optional — needs an Apple Developer account).
# APPLE_CLIENT_ID = the Services ID; return URL: https://<your domain>/api/auth/apple/callback
# APPLE_PRIVATE_KEY = the whole .p8 key file's text (newlines may be written as \n).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
